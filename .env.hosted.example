# Copy to .env.hosted.staging or .env.hosted.beta (ignored); do not paste values into chat.
# Separate Neon projects and secrets for staging and beta; staging data stays synthetic.
# Select the same branch/database for both URLs. MCP login does not fill these values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
# Direct URL for migration/backup helpers; map DATABASE_URL_UNPOOLED here if exported by Neon.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_URL=https://replace-after-deploy.cloudfront.net
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_FORM_ID=1FlImQbVjBMarRResx4EJUA05j3ocbRGYcYaQ2T1XuhM
# Generate these separately: .venv/bin/python -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=
INTAKE_SECRET=
# Aura driver URI, not the HTTPS MCP endpoint. Backend database name is neo4j.
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NATIVE_SIGNUP=false
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
